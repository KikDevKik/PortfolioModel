# Copy these into Vercel → Project → Settings → Environment Variables
# (and into a file called .env.local if you ever run the site on your computer).

# Cloudinary → Dashboard (top of the page)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Keystatic Cloud → your project (format: team-name/project-name)
NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=

# Your final web address, e.g. https://deinertrelles.com
NEXT_PUBLIC_SITE_URL=
